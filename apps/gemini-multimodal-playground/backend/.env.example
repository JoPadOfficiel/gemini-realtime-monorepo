# =============================================================================
# GEMINI LIVE BACKEND API - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the FastAPI backend.
# Copy this file to .env and fill in your actual values.
#
# SECURITY NOTE: Never commit .env or any file containing real credentials!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
# 1. Sign in with your Google account
# 2. Click "Create API Key"
# 3. Copy the generated key (starts with "AIza...")
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# Memory Management (Mem0)
# -----------------------------------------------------------------------------
# Get your API key from: https://app.mem0.ai/
# Mem0 provides long-term memory capabilities for AI conversations
# Free tier available for development and testing
MEM0_API_KEY=your-mem0-api-key-here

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host address - use 0.0.0.0 to accept connections from any IP
# For local development only, use 127.0.0.1
HOST=0.0.0.0

# Port for the FastAPI server
# Default: 8000 (make sure this port is available)
PORT=8000

# WebSocket port for real-time communication
# Default: 8765 (make sure this port is available)
WEBSOCKET_PORT=8765

# Enable debug mode for development
# Set to false in production for better performance
DEBUG=true

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing
# Add your frontend URLs here (comma-separated)
# Development: http://localhost:3000,http://localhost:3001
# Production: https://your-app.vercel.app,https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?options
#
# For Neon DB (recommended for production):
# 1. Sign up at https://neon.tech/
# 2. Create a new project
# 3. Copy the connection string from your dashboard
#
# For local PostgreSQL development:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/gemini_realtime
#
# For production, ensure SSL is enabled:
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# -----------------------------------------------------------------------------
# Production Deployment (Optional)
# -----------------------------------------------------------------------------
# These are only needed for production deployment with specific configurations

# Production server settings (if different from above)
# PROD_HOST=0.0.0.0
# PROD_PORT=443

# SSL/TLS Configuration (for HTTPS)
# SSL_CERT_PATH=/path/to/your/certificate.pem
# SSL_KEY_PATH=/path/to/your/private-key.pem

# -----------------------------------------------------------------------------
# Logging and Monitoring (Optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable request logging for debugging
# LOG_REQUESTS=false

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
# Maximum requests per minute per IP
# RATE_LIMIT_PER_MINUTE=60

# Maximum concurrent WebSocket connections
# MAX_WEBSOCKET_CONNECTIONS=100