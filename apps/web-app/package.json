{
  "name": "saas-starter",
  "version": "0.3.1",
  "private": true,
  "author": {
    "name": "jopad",
    "url": "https://twitter.com/jopadofficiel"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "next build",
    "build:turbo": "next build --turbo",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "preview": "next build && next start",
    "clean": "rm -rf .next .content-collections",
    "build:analyze": "ANALYZE=true next build",
    "build:info": "echo '📦 Next.js 15 Build Options:' && echo '  • pnpm run build        → Production build (Webpack - Recommended)' && echo '  • pnpm run build:turbo  → Turbopack build (Experimental - Faster)' && echo '  • pnpm run dev          → Development with Turbopack' && echo '  • pnpm run dev:webpack  → Development with Webpack' && echo '  • pnpm run preview      → Build and preview locally' && echo '  • pnpm run clean        → Clean build artifacts'",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && prisma generate && next build",
    "email": "email dev --dir emails --port 3333",
    "db:push": "dotenv -e .env.local -- npx prisma db push",
    "db:migrate": "dotenv -e .env.local -- npx prisma migrate dev",
    "db:generate": "dotenv -e .env.local -- npx prisma generate",
    "db:studio": "dotenv -e .env.local -- npx prisma studio",
    "db:seed": "dotenv -e .env.local -- npx prisma db seed",
    "docs:generate": "node scripts/generate-openapi.js",
    "docs:validate": "node scripts/validate-openapi.js",
    "docs:dev": "concurrently \"pnpm run dev\" \"pnpm run docs:watch\"",
    "docs:watch": "nodemon --watch app/api --watch lib/validations --ext ts,tsx,js --exec \"pnpm run docs:generate\"",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel"
  },
