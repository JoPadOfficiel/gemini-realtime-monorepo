# =============================================================================
# GEMINI REALTIME MONOREPO - WEB APP ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the Next.js web application.
# Copy this file to .env.local and fill in your actual values.
#
# SECURITY NOTE: Never commit .env.local or any file containing real credentials!
# =============================================================================

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# The public URL where your app will be accessible
# Development: http://localhost:3000 or http://localhost:3001
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js requires this to be set for proper authentication
# Should match NEXT_PUBLIC_APP_URL in most cases
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Gemini Live Backend API
# -----------------------------------------------------------------------------
# URL to your Gemini Live backend API
# Development: http://localhost:8000
# Production with Cloudflare Tunnel: https://your-tunnel-url.trycloudflare.com
# Production with VPS: https://your-domain.com:8000
NEXT_PUBLIC_GEMINI_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# Generate a secure random string for AUTH_SECRET
# You can use: openssl rand -base64 32
# Or online generator: https://generate-secret.vercel.app/32
AUTH_SECRET=your-super-secret-auth-key-here

# Google OAuth Configuration
# Get these from: https://console.developers.google.com/
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth Configuration
# Get this from: https://github.com/settings/tokens
# Required scopes: read:user, user:email
GITHUB_OAUTH_TOKEN=ghp_your-github-personal-access-token

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?options
#
# For Neon DB (recommended):
# 1. Sign up at https://neon.tech/
# 2. Create a new project
# 3. Copy the connection string from your dashboard
#
# For local PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/gemini_realtime
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# -----------------------------------------------------------------------------
# Email Service (Resend)
# -----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
# Free tier includes 3,000 emails/month
RESEND_API_KEY=re_your-resend-api-key-here

# The "From" address for outgoing emails
# Must be a verified domain in your Resend account
EMAIL_FROM="Your App Name <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Payment Processing (Stripe)
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
STRIPE_API_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-endpoint-secret

# Stripe Product/Price IDs
# Create these in your Stripe Dashboard under Products
# These are public and safe to expose in client-side code
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PLAN_ID=price_your-pro-monthly-price-id
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PLAN_ID=price_your-pro-yearly-price-id
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PLAN_ID=price_your-business-monthly-price-id
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PLAN_ID=price_your-business-yearly-price-id

# -----------------------------------------------------------------------------
# Optional: Analytics and Monitoring
# -----------------------------------------------------------------------------
# Uncomment and configure if you want to add analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# Set to true to enable debug logging in development
# DEBUG=true